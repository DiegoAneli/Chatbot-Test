# Porta del server Express
PORT=3000

# Incolla qui la tua API Key di OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modello OpenRouter (opzionale, es. meta-llama/llama-3.3-70b-instruct:free, mistralai/mistral-7b-instruct:free, openai/gpt-4o-mini)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

