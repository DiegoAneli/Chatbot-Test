# Ignora errori di certificato TLS auto-firmato per proxy/antivirus/firewall
NODE_TLS_REJECT_UNAUTHORIZED=0

# Porta del server Express
PORT=3000

# Incolla qui la tua API Key di OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modello Baidu
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Modello Backup meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_BACKUP=meta-llama/llama-3.3-70b-instruct:free

# Modello Openrouter free
OPENROUTER_FALLBACK_MODEL=openrouter/free